# Public backend URL. VITE_* values are embedded in the browser bundle.
VITE_API_URL=http://localhost:8000

# Public Google Maps JavaScript API key. Restrict by HTTP referrer and API.
# Separate from the private server key. Needed to map Google Places itineraries.
VITE_GOOGLE_MAPS_API_KEY=
# Optional production map ID; DEMO_MAP_ID is used during development.
VITE_GOOGLE_MAP_ID=

# Optional with Google; required for the Claude + Nominatim fallback.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6
# Set false for Google-only discovery without paid Anthropic requests.
ENABLE_AI_SUGGESTIONS=true
# Comma-separated frontend origins. Set the production domain in Cloud Run.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enable Places API (New) and Routes API in Google Cloud.
# Keep this server key private. Leave empty to use Claude + Nominatim.
GOOGLE_MAPS_API_KEY=
# Query only planned legs, capped per generation/retrieval (0 disables Routes).
GOOGLE_ROUTES_MAX_ELEMENTS=20

# Optional: provide both values to persist itineraries in Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key
